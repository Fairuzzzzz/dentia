<aside class="w-64 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 flex flex-col">
  <div class="p-4 border-b border-gray-200 dark:border-gray-700">
    <h1 class="text-base font-bold text-teal-600">Dentia</h1>
    <p class="text-[10px] text-gray-400"><%= t("sidebar.clinic") %></p>
  </div>

  <nav class="flex-1 p-4 space-y-1">
    <%= link_to dashboard_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{current_page?(dashboard_path) ? 'bg-teal-50 dark:bg-teal-900/50 text-teal-700 dark:text-teal-300 font-medium' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700'}" do %>
      <%= lucide_icon "layout-dashboard", class: "w-4 h-4" %> <%= t("sidebar.dashboard") %>
    <% end %>

    <%= link_to patients_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{controller_name == 'patients' ? 'bg-teal-50 dark:bg-teal-900/50 text-teal-700 dark:text-teal-300 font-medium' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700'}" do %>
      <%= lucide_icon "users", class: "w-4 h-4" %> <%= t("sidebar.patients") %>
    <% end %>

    <%= link_to visits_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{controller_name == 'visits' ? 'bg-teal-50 dark:bg-teal-900/50 text-teal-700 dark:text-teal-300 font-medium' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700'}" do %>
      <%= lucide_icon "clipboard-list", class: "w-4 h-4" %> <%= t("sidebar.visits") %>
    <% end %>
    
    <%= link_to appointments_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{controller_name == 'appointments' ? 'bg-teal-50 dark:bg-teal-900/50 text-teal-700 dark:text-teal-300 font-medium' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700'}" do %>
      <%= lucide_icon "calendar", class: "w-4 h-4" %> <%= t("sidebar.appointments") %>
    <% end %>    

    <%= link_to billings_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{controller_name == 'billings' ? 'bg-teal-50 dark:bg-teal-900/50 text-teal-700 dark:text-teal-300 font-medium' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700'}" do %>
      <%= lucide_icon "wallet", class: "w-4 h-4" %> <%= t("sidebar.billings") %>
    <% end %>    

    <%= link_to reports_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{controller_name == 'reports' ? 'bg-teal-50 dark:bg-teal-900/50 text-teal-700 dark:text-teal-300 font-medium' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700'}" do %>
      <%= lucide_icon "chart-bar", class: "w-4 h-4" %> <%= t("sidebar.reports") %>
    <% end %>

    <%= link_to treatment_catalogs_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{current_page?(treatment_catalogs_path) ? 'bg-teal-50 dark:bg-teal-900/50 text-teal-700 dark:text-teal-300 font-medium' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700'}" do %>
      <%= lucide_icon "list-checks", class: "w-4 h-4" %> <%= t("sidebar.treatment_catalog") %>
    <% end %>

    <div class="pt-4 mt-4 border-t border-gray-200 dark:border-gray-700">
      <p class="px-3 text-xs font-medium text-gray-400 uppercase tracking-wider"><%= t("sidebar.settings_title") %></p>

      <%= link_to settings_preferences_path, class: "mt-2 flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{controller_name == 'preferences' ? 'bg-teal-50 dark:bg-teal-900/50 text-teal-700 dark:text-teal-300 font-medium' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700'}" do %>
        <%= lucide_icon "settings", class: "w-4 h-4" %> <%= t("sidebar.settings") %>
      <% end %>

      <%= link_to edit_profile_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{controller_name == 'profiles' ? 'bg-teal-50 dark:bg-teal-900/50 text-teal-700 dark:text-teal-300 font-medium' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700'}" do %>
        <%= lucide_icon "user", class: "w-4 h-4" %> <%= t("sidebar.doctor_profile") %>
      <% end %>
    </div>
  </nav>

  <div class="p-4 border-t border-gray-200 dark:border-gray-700">
    <%= button_to destroy_user_session_path, method: :delete,
        data: { turbo_confirm: "Yakin ingin keluar?" },
        class: "w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition" do %>
      <%= lucide_icon "log-out", class: "w-4 h-4" %> <%= t("sidebar.logout") %>
    <% end %>
  </div>
</aside>
