<aside class="w-64 bg-white border-r border-gray-200 flex flex-col">
  <div class="p-4 border-b border-gray-200">
    <h1 class="text-base font-bold text-teal-600">Dentia</h1>
    <p class="text-[10px] text-gray-400">Klinik Gigi</p>
  </div>

  <nav class="flex-1 p-4 space-y-1">
    <%= link_to dashboard_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{current_page?(dashboard_path) ? 'bg-teal-50 text-teal-700 font-medium' : 'text-gray-700 hover:bg-gray-100'}" do %>
      <%= lucide_icon "layout-dashboard", class: "w-4 h-4" %> Dashboard
    <% end %>
    <%= link_to patients_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{controller_name == 'patients' ? 'bg-teal-50 text-teal-700 font-medium' : 'text-gray-700 hover:bg-gray-100'}" do %>
      <%= lucide_icon "users", class: "w-4 h-4" %> Pasien
    <% end %>
    <%= link_to visits_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{controller_name == 'visits' ? 'bg-teal-50 text-teal-700 font-medium' : 'text-gray-700 hover:bg-gray-100'}" do %>
      <%= lucide_icon "clipboard-list", class: "w-4 h-4" %> Kunjungan
    <% end %>
    <%= link_to "#", class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-700 hover:bg-gray-100" do %>
      <%= lucide_icon "calendar", class: "w-4 h-4" %> Jadwal
    <% end %>
    <%= link_to "#", class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-700 hover:bg-gray-100" do %>
      <%= lucide_icon "wallet", class: "w-4 h-4" %> Pembiayaan
    <% end %>
    <%= link_to "#", class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-700 hover:bg-gray-100" do %>
      <%= lucide_icon "chart-bar", class: "w-4 h-4" %> Laporan
    <% end %>
    <%= link_to treatment_catalogs_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{current_page?(treatment_catalogs_path) ? 'bg-teal-50 text-teal-700 font-medium' : 'text-gray-700 hover:bg-gray-100'}" do %>
      <%= lucide_icon "list-checks", class: "w-4 h-4" %> Katalog Tindakan
    <% end %>

    <div class="pt-4 mt-4 border-t border-gray-200">
      <p class="px-3 text-xs font-medium text-gray-400 uppercase tracking-wider">Pengaturan</p>
      <%= link_to "#", class: "mt-2 flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-700 hover:bg-gray-100" do %>
        <%= lucide_icon "settings", class: "w-4 h-4" %> Settings
      <% end %>
      <%= link_to "#", class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-700 hover:bg-gray-100" do %>
        <%= lucide_icon "user", class: "w-4 h-4" %> Profil Dokter
      <% end %>
    </div>
  </nav>

  <div class="p-4 border-t border-gray-200">
    <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-red-600 hover:bg-red-50" do %>
      <%= lucide_icon "log-out", class: "w-4 h-4" %> Keluar
    <% end %>
  </div>
</aside>
