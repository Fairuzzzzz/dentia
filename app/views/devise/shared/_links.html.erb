<%- if controller_name != 'sessions' %>
  <p class="text-sm text-gray-500"><%= link_to "Masuk", new_session_path(resource_name), class: "text-teal-600 hover:underline" %></p>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <p class="text-sm text-gray-500">Belum punya akun? <%= link_to "Daftar", new_registration_path(resource_name), class: "text-teal-600 hover:underline" %></p>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <p class="text-sm text-gray-500 mt-1"><%= link_to "Lupa kata sandi?", new_password_path(resource_name), class: "text-teal-600 hover:underline" %></p>
<% end %>
