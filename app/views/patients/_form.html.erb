<%= form_with model: @patient, class: "space-y-4" do |f| %>
  <% if @patient.errors.any? %>
    <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
      <ul class="list-disc pl-4 space-y-1">
        <% @patient.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :nik, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :nik, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "16 digit NIK" %>
    </div>

    <div>
      <%= f.label :patient_number, t("patients.form.patient_number"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :patient_number, class: "w-full px-3 py-2 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-500", disabled: true, value: @patient.patient_number || t("patients.form.auto_generate") %>
    </div>
  </div>

  <div>
    <%= f.label :name, t("patients.form.full_name"), class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: t("patients.form.full_name") %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :birth_date, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.date_field :birth_date, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
    </div>

    <div>
      <%= f.label :gender, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :gender, options_for_select([[t("patients.form.male"), "male"], [t("patients.form.female"), "female"]], @patient.gender), { prompt: t("patients.form.select_gender") }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :phone, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: t("patients.form.phone_placeholder") %>
    </div>

    <div>
      <%= f.label :blood_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :blood_type, options_for_select(["A", "B", "AB", "O"], @patient.blood_type), { prompt: t("patients.form.select_blood") }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
    </div>
  </div>

  <div>
    <%= f.label :address, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :address, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: t("patients.form.address_placeholder") %>
  </div>

  <div>
    <%= f.label :allergies, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :allergies, rows: 2, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: t("patients.form.allergies_placeholder") %>
  </div>

  <div class="flex items-center gap-3 pt-3 border-t border-gray-100">
    <%= f.submit t("common.save"), class: "px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition text-sm font-medium" %>
    <%= link_to t("common.cancel"), patients_path, class: "px-4 py-2 text-gray-600 hover:text-gray-800 transition text-sm" %>
  </div>
<% end %>
