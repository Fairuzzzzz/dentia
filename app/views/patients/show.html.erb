<div class="max-w-5xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to patients_path, class: "p-1.5 text-gray-400 hover:text-gray-600 transition" do %>
      <%= lucide_icon "arrow-left", class: "w-5 h-5" %>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900">Detail Pasien</h1>
    <div class="ml-auto flex items-center gap-2">
      <%= link_to edit_patient_path(@patient), class: "inline-flex items-center gap-2 px-4 py-2 bg-amber-500 text-white rounded-lg hover:bg-amber-600 transition text-sm font-medium" do %>
        <%= lucide_icon "pencil", class: "w-4 h-4" %> Edit
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6 mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Data Pasien</h2>
    <div class="grid grid-cols-2 gap-4 text-sm">
      <div class="flex gap-2"><span class="w-32 text-gray-500 shrink-0">No. RM</span><span class="font-mono text-gray-900"><%= @patient.patient_number %></span></div>
      <div class="flex gap-2"><span class="w-32 text-gray-500 shrink-0">NIK</span><span class="text-gray-900"><%= @patient.nik || "-" %></span></div>
      <div class="flex gap-2"><span class="w-32 text-gray-500 shrink-0">Nama</span><span class="text-gray-900 font-medium"><%= @patient.name %></span></div>
      <div class="flex gap-2"><span class="w-32 text-gray-500 shrink-0">Jenis Kelamin</span><span class="text-gray-900"><%= @patient.gender == "male" ? "Laki-laki" : @patient.gender == "female" ? "Perempuan" : "-" %></span></div>
      <div class="flex gap-2"><span class="w-32 text-gray-500 shrink-0">Tanggal Lahir</span><span class="text-gray-900"><%= @patient.birth_date&.strftime("%d/%m/%Y") || "-" %></span></div>
      <div class="flex gap-2"><span class="w-32 text-gray-500 shrink-0">Gol. Darah</span><span class="text-gray-900"><%= @patient.blood_type || "-" %></span></div>
      <div class="flex gap-2"><span class="w-32 text-gray-500 shrink-0">Telepon</span><span class="text-gray-900"><%= @patient.phone || "-" %></span></div>
      <div class="flex gap-2"><span class="w-32 text-gray-500 shrink-0">Alamat</span><span class="text-gray-900"><%= @patient.address.presence || "-" %></span></div>
      <div class="flex gap-2 col-span-2"><span class="w-32 text-gray-500 shrink-0">Alergi</span><span class="text-gray-900"><%= @patient.allergies.presence || "-" %></span></div>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-200 bg-gray-50">
      <h2 class="text-sm font-semibold text-gray-700">Riwayat Kunjungan</h2>
    </div>
    <table class="w-full">
      <thead>
        <tr class="border-b border-gray-200">
          <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">No. Kunjungan</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Tanggal</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Keluhan</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @patient.visits.order(visit_date: :desc).each do |visit| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-3 text-sm font-mono text-gray-700"><%= visit.visit_number %></td>
            <td class="px-4 py-3 text-sm text-gray-600"><%= visit.visit_date.strftime("%d/%m/%Y %H:%M") %></td>
            <td class="px-4 py-3 text-sm text-gray-600"><%= truncate(visit.chief_complaint, length: 50) %></td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= visit.status == "completed" ? "bg-green-100 text-green-800" : visit.status == "in_progress" ? "bg-blue-100 text-blue-800" : "bg-gray-100 text-gray-600" %>">
                <%= visit.status.humanize %>
              </span>
            </td>
          </tr>
        <% end %>
        <% if @patient.visits.empty? %>
          <tr>
            <td colspan="4" class="px-4 py-12 text-center text-gray-400">
              Belum ada kunjungan
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
