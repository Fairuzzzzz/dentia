<div class="space-y-6">
  <h1 class="text-2xl font-bold text-gray-900"><%= t("dashboard.title") %></h1>

  <%# Stat Cards %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
          <%= lucide_icon "clipboard-list", class: "w-5 h-5 text-teal-600" %>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= @today_visit_count %></p>
          <p class="text-xs text-gray-500"><%= t("dashboard.today_visits") %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
          <%= lucide_icon "users", class: "w-5 h-5 text-blue-600" %>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= @new_patients_this_month %></p>
          <p class="text-xs text-gray-500"><%= t("dashboard.new_patients") %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
          <%= lucide_icon "calendar", class: "w-5 h-5 text-amber-600" %>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= @today_appointment_count %></p>
          <p class="text-xs text-gray-500"><%= t("dashboard.today_appointments") %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
          <%= lucide_icon "wallet", class: "w-5 h-5 text-green-600" %>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= number_to_currency(@today_revenue, unit: "Rp ", separator: ",", delimiter: ".") %></p>
          <p class="text-xs text-gray-500"><%= t("dashboard.today_revenue") %></p>
        </div>
      </div>
    </div>
  </div>

  <%# Chart and Actions Row %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <%# Chart %>
    <div class="col-span-2 bg-white rounded-xl border border-gray-200 p-4">
      <h2 class="text-sm font-semibold text-gray-700 mb-4"><%= t("dashboard.chart_title") %></h2>
      <div class="flex items-end gap-2 h-40" style="border-bottom: 1px solid #e5e7eb;">
        <% if @visits_by_day.any? { |d| d[:count] > 0 } %>
          <% max_h = 120 %>
          <% @visits_by_day.each do |day| %>
            <% bar_h = day[:count] > 0 ? (day[:count].to_f / @max_visit_count * max_h).round : 0 %>
            <div class="flex-1 flex flex-col items-center justify-end h-full">
              <% if day[:count] > 0 %>
                <span class="text-[10px] text-gray-500 font-medium mb-1"><%= day[:count] %></span>
                <div class="w-full max-w-[32px] bg-teal-500 rounded-t" style="height: <%= bar_h %>px;"></div>
              <% else %>
                <span class="text-[10px] text-gray-300 mb-1">0</span>
                <div class="w-full max-w-[32px]" style="height: 1px;"></div>
              <% end %>
              <span class="text-xs text-gray-400 mt-1"><%= t("date.abbr_day_names")[day[:date].wday] %></span>
            </div>
          <% end %>
        <% else %>
          <div class="w-full flex items-center justify-center h-full text-sm text-gray-400">
            Belum ada data kunjungan 7 hari terakhir
          </div>
        <% end %>
      </div>
    </div>

    <%# Quick Actions %>
    <div class="flex flex-col gap-3">
      <%= link_to new_patient_path, class: "flex-1 flex items-center bg-white rounded-xl border border-gray-200 p-4 hover:border-teal-300 hover:shadow-sm transition" do %>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
            <%= lucide_icon "user-plus", class: "w-5 h-5 text-teal-600" %>
          </div>
          <div>
          <p class="text-sm font-medium text-gray-900"><%= t("dashboard.new_patient") %></p>
          <p class="text-xs text-gray-500"><%= t("dashboard.register_patient") %></p>
          </div>
        </div>
      <% end %>
      <%= link_to new_visit_path, class: "flex-1 flex items-center bg-white rounded-xl border border-gray-200 p-4 hover:border-teal-300 hover:shadow-sm transition" do %>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
            <%= lucide_icon "plus-circle", class: "w-5 h-5 text-blue-600" %>
          </div>
          <div>
          <p class="text-sm font-medium text-gray-900"><%= t("dashboard.new_visit") %></p>
          <p class="text-xs text-gray-500"><%= t("dashboard.create_visit") %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Today's Visits %>
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-700"><%= t("dashboard.today_visits") %></h2>
      <%= link_to visits_path, class: "text-xs text-teal-600 hover:underline" do %>
        <%= t("dashboard.view_all") %>
      <% end %>
    </div>
    <div class="overflow-x-auto">
    <table class="w-full min-w-[500px]">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-200">
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500"><%= t("visits.table.patient") %></th>
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500"><%= t("common.time") %></th>
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500"><%= t("visits.table.complaint") %></th>
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500"><%= t("visits.table.status") %></th>
          <th class="text-right px-4 py-2 text-xs font-medium text-gray-500"><%= t("common.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @today_visits.each do |visit| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-2 text-sm font-medium text-gray-900"><%= visit.patient.name %></td>
            <td class="px-4 py-2 text-sm text-gray-600"><%= visit.visit_date.strftime("%H:%M") %></td>
            <td class="px-4 py-2 text-sm text-gray-600 truncate max-w-xs"><%= visit.chief_complaint %></td>
            <td class="px-4 py-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= visit.status == "completed" ? "bg-green-100 text-green-800" : visit.status == "in_progress" ? "bg-blue-100 text-blue-800" : "bg-gray-100 text-gray-600" %>">
                <%= t("status.#{visit.status}") %>
              </span>
            </td>
            <td class="px-4 py-2 text-right">
              <%= link_to edit_visit_path(visit), class: "text-xs text-teal-600 hover:underline" do %>
                <%= t("common.edit") %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @today_visits.empty? %>
          <tr>
            <td colspan="5" class="px-4 py-6 text-center text-gray-400 text-sm">
              <%= t("dashboard.no_visits") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>

  <%# Upcoming Appointments %>
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-700"><%= t("dashboard.today_appointments") %></h2>
      <%= link_to appointments_path, class: "text-xs text-teal-600 hover:underline" do %>
        <%= t("dashboard.view_all") %>
      <% end %>
    </div>
    <div class="overflow-x-auto">
    <table class="w-full min-w-[500px]">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-200">
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500"><%= t("billings.table.date") %></th>
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500"><%= t("common.time") %></th>
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500"><%= t("visits.table.patient") %></th>
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500"><%= t("activerecord.attributes.appointment.purpose") %></th>
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500"><%= t("common.status") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @upcoming_appointments.each do |apt| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-2 text-sm text-gray-600"><%= apt.appointment_date.strftime("%d/%m") %></td>
            <td class="px-4 py-2 text-sm text-gray-900 font-medium"><%= apt.appointment_date.strftime("%H:%M") %></td>
            <td class="px-4 py-2 text-sm text-gray-900"><%= apt.patient.name %></td>
            <td class="px-4 py-2 text-sm text-gray-600 truncate max-w-xs"><%= apt.purpose %></td>
            <td class="px-4 py-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= apt.status == "confirmed" ? "bg-blue-100 text-blue-800" : "bg-gray-100 text-gray-600" %>">
                <%= t("status.#{apt.status}") %>
              </span>
            </td>
          </tr>
        <% end %>
        <% if @upcoming_appointments.empty? %>
          <tr>
            <td colspan="5" class="px-4 py-6 text-center text-gray-400 text-sm">
              <%= t("dashboard.no_appointments") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
</div>
