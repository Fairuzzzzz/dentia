<div class="space-y-6">
  <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>

  <%# Stat Cards %>
  <div class="grid grid-cols-4 gap-4">
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
          <%= lucide_icon "clipboard-list", class: "w-5 h-5 text-teal-600" %>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= @today_visit_count %></p>
          <p class="text-xs text-gray-500">Kunjungan Hari Ini</p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
          <%= lucide_icon "users", class: "w-5 h-5 text-blue-600" %>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= @new_patients_this_month %></p>
          <p class="text-xs text-gray-500">Pasien Baru Bulan Ini</p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
          <%= lucide_icon "calendar", class: "w-5 h-5 text-amber-600" %>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= @today_appointment_count %></p>
          <p class="text-xs text-gray-500">Janji Temu Hari Ini</p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
          <%= lucide_icon "wallet", class: "w-5 h-5 text-green-600" %>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= number_to_currency(@today_revenue, unit: "Rp ", separator: ",", delimiter: ".") %></p>
          <p class="text-xs text-gray-500">Pendapatan Hari Ini</p>
        </div>
      </div>
    </div>
  </div>

  <%# Chart and Actions Row %>
  <div class="grid grid-cols-3 gap-4">
    <%# Chart %>
    <div class="col-span-2 bg-white rounded-xl border border-gray-200 p-4">
      <h2 class="text-sm font-semibold text-gray-700 mb-4">Kunjungan 7 Hari Terakhir</h2>
      <div class="flex items-end gap-2 h-32">
        <% @visits_by_day.each do |day| %>
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-teal-500 rounded-t" style="height: <%= (day[:count].to_f / @max_visit_count * 100).round %>%"></div>
            <span class="text-xs text-gray-400"><%= day[:date]&.strftime("%a") %></span>
          </div>
        <% end %>
      </div>
    </div>

    <%# Quick Actions %>
    <div class="flex flex-col gap-3">
      <%= link_to new_patient_path, class: "flex-1 flex items-center bg-white rounded-xl border border-gray-200 p-4 hover:border-teal-300 hover:shadow-sm transition" do %>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center">
            <%= lucide_icon "user-plus", class: "w-5 h-5 text-teal-600" %>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-900">Pasien Baru</p>
            <p class="text-xs text-gray-500">Daftarkan pasien baru</p>
          </div>
        </div>
      <% end %>
      <%= link_to new_visit_path, class: "flex-1 flex items-center bg-white rounded-xl border border-gray-200 p-4 hover:border-teal-300 hover:shadow-sm transition" do %>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
            <%= lucide_icon "plus-circle", class: "w-5 h-5 text-blue-600" %>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-900">Kunjungan Baru</p>
            <p class="text-xs text-gray-500">Buat kunjungan pasien</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Today's Visits %>
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-700">Kunjungan Hari Ini</h2>
      <%= link_to visits_path, class: "text-xs text-teal-600 hover:underline" do %>
        Lihat Semua
      <% end %>
    </div>
    <table class="w-full">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-200">
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500">Pasien</th>
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500">Jam</th>
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500">Keluhan</th>
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500">Status</th>
          <th class="text-right px-4 py-2 text-xs font-medium text-gray-500">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @today_visits.each do |visit| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-2 text-sm font-medium text-gray-900"><%= visit.patient.name %></td>
            <td class="px-4 py-2 text-sm text-gray-600"><%= visit.visit_date.strftime("%H:%M") %></td>
            <td class="px-4 py-2 text-sm text-gray-600 truncate max-w-xs"><%= visit.chief_complaint %></td>
            <td class="px-4 py-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= visit.status == "completed" ? "bg-green-100 text-green-800" : visit.status == "in_progress" ? "bg-blue-100 text-blue-800" : "bg-gray-100 text-gray-600" %>">
                <%= visit.status.humanize %>
              </span>
            </td>
            <td class="px-4 py-2 text-right">
              <%= link_to edit_visit_path(visit), class: "text-xs text-teal-600 hover:underline" do %>
                Edit
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @today_visits.empty? %>
          <tr>
            <td colspan="5" class="px-4 py-6 text-center text-gray-400 text-sm">
              Belum ada kunjungan hari ini
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Upcoming Appointments %>
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-700">Janji Temu Mendatang</h2>
      <%= link_to appointments_path, class: "text-xs text-teal-600 hover:underline" do %>
        Lihat Semua
      <% end %>
    </div>
    <table class="w-full">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-200">
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500">Tanggal</th>
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500">Jam</th>
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500">Pasien</th>
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500">Keperluan</th>
          <th class="text-left px-4 py-2 text-xs font-medium text-gray-500">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @upcoming_appointments.each do |apt| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-2 text-sm text-gray-600"><%= apt.appointment_date.strftime("%d/%m") %></td>
            <td class="px-4 py-2 text-sm text-gray-900 font-medium"><%= apt.appointment_date.strftime("%H:%M") %></td>
            <td class="px-4 py-2 text-sm text-gray-900"><%= apt.patient.name %></td>
            <td class="px-4 py-2 text-sm text-gray-600 truncate max-w-xs"><%= apt.purpose %></td>
            <td class="px-4 py-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= apt.status == "confirmed" ? "bg-blue-100 text-blue-800" : "bg-gray-100 text-gray-600" %>">
                <%= apt.status.humanize %>
              </span>
            </td>
          </tr>
        <% end %>
        <% if @upcoming_appointments.empty? %>
          <tr>
            <td colspan="5" class="px-4 py-6 text-center text-gray-400 text-sm">
              Tidak ada janji temu mendatang
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
