<div class="max-w-5xl mx-auto">
  <div class="flex items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Kunjungan</h1>
    <div class="ml-auto -mr-6 bg-teal-600 rounded-lg px-4 py-2">
      <%= link_to new_visit_path, class: "inline-flex items-center gap-2 text-white text-sm font-medium" do %>
        <%= lucide_icon "plus", class: "w-4 h-4" %> Baru
      <% end %>
    </div>
  </div>

  <%= form_tag visits_path, method: :get, class: "mb-4 flex flex-wrap gap-2" do %>
    <%= text_field_tag :search, params[:search], placeholder: "Cari pasien / no. kunjungan...", class: "w-full max-w-xs px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
    <%= select_tag :status, options_for_select([["Semua Status", ""], ["Terdaftar", "registered"], ["Diperiksa", "in_progress"], ["Selesai", "completed"]], params[:status]), class: "px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
    <%= date_field_tag :start_date, params[:start_date], class: "px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Dari" %>
    <%= date_field_tag :end_date, params[:end_date], class: "px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Sampai" %>
    <%= submit_tag "Filter", class: "px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition text-sm font-medium cursor-pointer" %>
  <% end %>

  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="w-full">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-200">
          <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">No. Kunjungan</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Pasien</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Tanggal</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Keluhan</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase tracking-wider">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @visits.each do |visit| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-3 text-sm font-mono text-gray-700"><%= visit.visit_number %></td>
            <td class="px-4 py-3 text-sm"><%= link_to visit.patient.name, visit.patient, class: "text-teal-600 hover:underline font-medium" %></td>
            <td class="px-4 py-3 text-sm text-gray-600"><%= visit.visit_date.strftime("%d/%m/%Y %H:%M") %></td>
            <td class="px-4 py-3 text-sm text-gray-600 max-w-xs truncate"><%= visit.chief_complaint %></td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= visit.status == "completed" ? "bg-green-100 text-green-800" : visit.status == "in_progress" ? "bg-blue-100 text-blue-800" : "bg-gray-100 text-gray-600" %>">
                <%= visit.status.humanize %>
              </span>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-2">
                <% if visit.status != "completed" %>
                  <%= button_to update_status_visit_path(visit, status: visit.status == "registered" ? "in_progress" : "completed"), method: :patch, class: "px-3 py-1.5 text-xs font-medium rounded-lg #{visit.status == "registered" ? "bg-blue-100 text-blue-700 hover:bg-blue-200" : "bg-green-100 text-green-700 hover:bg-green-200"} transition" do %>
                    <%= visit.status == "registered" ? "Mulai Periksa" : "Selesai" %>
                  <% end %>
                <% end %>
                <%= link_to edit_visit_path(visit), class: "p-1.5 text-gray-400 hover:text-teal-600 hover:bg-teal-50 rounded-lg transition" do %>
                  <%= lucide_icon "file-text", class: "w-4 h-4" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @visits.empty? %>
          <tr>
            <td colspan="6" class="px-4 py-12 text-center text-gray-400">
              Belum ada kunjungan. <%= link_to "Buat kunjungan baru", new_visit_path, class: "text-teal-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
