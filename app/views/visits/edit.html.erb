<div class="max-w-5xl mx-auto overflow-x-hidden">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to visits_path, class: "p-1.5 text-gray-400 hover:text-gray-600 transition" do %>
      <%= lucide_icon "arrow-left", class: "w-5 h-5" %>
    <% end %>
    <div class="flex-1">
      <h1 class="text-2xl font-bold text-gray-900">
        <%= @visit.visit_number %>
        <span class="text-base font-normal text-gray-500">— <%= @visit.patient.name %></span>
      </h1>
      <p class="text-sm text-gray-500">
        <%= @visit.visit_date.strftime("%d %B %Y %H:%M") %>
        <span class="inline-flex items-center ml-2 px-2 py-0.5 rounded-full text-xs font-medium <%= @visit.status == "completed" ? "bg-green-100 text-green-800" : @visit.status == "in_progress" ? "bg-blue-100 text-blue-800" : "bg-gray-100 text-gray-600" %>">
          <%= @visit.status.humanize %>
        </span>
      </p>
    </div>
    <% if @visit.status != "completed" %>
      <%= button_to update_status_visit_path(@visit, status: @visit.status == "registered" ? "in_progress" : "completed"), method: :patch, class: "px-4 py-2 #{@visit.status == "registered" ? "bg-blue-600 hover:bg-blue-700" : "bg-green-600 hover:bg-green-700"} text-white rounded-lg transition text-sm font-medium" do %>
        <%= @visit.status == "registered" ? "Mulai Periksa" : "Selesai" %>
      <% end %>
    <% end %>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <%= form_with model: @visit, class: "space-y-8" do |f| %>
      <% if @visit.errors.any? %>
        <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
          <ul class="list-disc pl-4 space-y-1">
            <% @visit.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= f.fields_for :medical_record do |mr| %>

        <%# ===== S — SUBJEKTIF ===== %>
        <section>
          <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
            <span class="w-8 h-8 bg-teal-100 text-teal-700 rounded-lg flex items-center justify-center text-sm font-bold">S</span>
            Subjektif
          </h2>

          <div class="space-y-4">
            <%= mr.fields_for :subjective_examination do |se| %>
              <div>
                <%= se.label :chief_complaint, "Keluhan Utama (CC)", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= se.text_area :chief_complaint, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Keluhan utama pasien" %>
              </div>

              <div>
                <%= se.label :present_illness_history, "Riwayat Penyakit Sekarang (RPS)", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= se.text_area :present_illness_history, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Riwayat penyakit sekarang" %>
              </div>
            <% end %>
          </div>
        </section>

        <hr class="border-gray-200">

        <%# ===== O — OBJEKTIF ===== %>
        <section>
          <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
            <span class="w-8 h-8 bg-blue-100 text-blue-700 rounded-lg flex items-center justify-center text-sm font-bold">O</span>
            Objektif
          </h2>

          <%= mr.fields_for :objective_examination do |oe| %>
            <div class="bg-gray-50 rounded-lg p-4 mb-4">
              <h3 class="text-sm font-semibold text-gray-700 mb-3">Tanda Vital</h3>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 md:gap-3">
                <div>
                  <%= oe.label :systole, "TD Sistole", class: "block text-xs font-medium text-gray-600 mb-1" %>
                  <%= oe.number_field :systole, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "mmHg" %>
                </div>
                <div>
                  <%= oe.label :diastole, "TD Diastole", class: "block text-xs font-medium text-gray-600 mb-1" %>
                  <%= oe.number_field :diastole, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "mmHg" %>
                </div>
                <div>
                  <%= oe.label :heart_rate, "Nadi", class: "block text-xs font-medium text-gray-600 mb-1" %>
                  <%= oe.number_field :heart_rate, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "bpm" %>
                </div>
                <div>
                  <%= oe.label :respiration_rate, "RR", class: "block text-xs font-medium text-gray-600 mb-1" %>
                  <%= oe.number_field :respiration_rate, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "x/mnt" %>
                </div>
                <div>
                  <%= oe.label :consciousness, "Kesadaran", class: "block text-xs font-medium text-gray-600 mb-1" %>
                  <%= oe.select :consciousness, options_for_select(["Composmentis", "Apatis", "Somnolen", "Sopor", "Koma"], oe.object&.consciousness), { prompt: "Pilih" }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
                </div>
                <div>
                  <%= oe.label :height, "Tinggi Badan", class: "block text-xs font-medium text-gray-600 mb-1" %>
                  <%= oe.number_field :height, step: 0.01, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "cm" %>
                </div>
                <div>
                  <%= oe.label :weight, "Berat Badan", class: "block text-xs font-medium text-gray-600 mb-1" %>
                  <%= oe.number_field :weight, step: 0.01, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "kg" %>
                </div>
                <div>
                  <%= oe.label :body_temperature, "Suhu", class: "block text-xs font-medium text-gray-600 mb-1" %>
                  <%= oe.number_field :body_temperature, step: 0.1, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "°C" %>
                </div>
              </div>

              <div class="mt-3">
                <%= oe.label :waist_circumference, "Lingkar Perut", class: "block text-xs font-medium text-gray-600 mb-1" %>
                <%= oe.number_field :waist_circumference, step: 0.01, class: "w-full max-w-xs px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "cm" %>
              </div>

              <div class="mt-3 p-3 bg-white rounded-lg border border-gray-200">
                <p class="text-xs text-gray-500">IMT: <span id="bmi"><%= oe.object&.bmi.present? ? number_with_precision(oe.object.bmi, precision: 1) : "-" %></span></p>
              </div>
            </div>

            <div>
              <%= oe.label :physical_examination, "Pemeriksaan Fisik", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= oe.text_area :physical_examination, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Pemeriksaan ekstraoral & intraoral" %>
            </div>

            <div class="mt-4">
              <h3 class="text-sm font-semibold text-gray-700 mb-2">Odontogram</h3>
              <%= oe.fields_for :odontogram do |od| %>
                <%= render "odontogram", f: od %>
              <% end %>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
              <div>
                <%= oe.label :supporting_action, "Tindakan Penunjang", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= oe.text_field :supporting_action, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Rontgen, dll" %>
              </div>
              <div>
                <%= oe.label :lab_result_notes, "Hasil Lab", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= oe.text_area :lab_result_notes, rows: 2, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Catatan hasil lab" %>
              </div>
            </div>
          <% end %>
        </section>

        <hr class="border-gray-200">

        <%# ===== A — ASSESSMENT ===== %>
        <section>
          <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
            <span class="w-8 h-8 bg-amber-100 text-amber-700 rounded-lg flex items-center justify-center text-sm font-bold">A</span>
            Assessment
          </h2>

          <%= mr.fields_for :assessment do |ass| %>
            <div data-controller="icd-autocomplete">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <%= ass.label :icd_code, "Kode ICD-10", class: "block text-sm font-medium text-gray-700 mb-1" %>
                  <div class="relative">
                    <%= ass.text_field :icd_code,
                        data: { icd_autocomplete_target: "input", action: "input->icd-autocomplete#search blur->icd-autocomplete#blur" },
                        class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none",
                        placeholder: "Ketik kode / diagnosis..." %>
                    <div data-icd-autocomplete-target="list"
                        class="hidden absolute z-10 mt-1 w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg max-h-64 overflow-y-auto"></div>
                  </div>
                </div>
              </div>

              <div class="mt-4">
                <%= ass.label :diagnosis, "Diagnosis Utama", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= ass.text_area :diagnosis, rows: 3, data: { icd_autocomplete_target: "diagnosis" },
                    class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Diagnosis utama" %>
              </div>
            </div>

            <div class="mt-4">
              <%= ass.label :diagnosis_notes, "Catatan Diagnosis", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= ass.text_area :diagnosis_notes, rows: 2, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Catatan tambahan" %>
            </div>
          <% end %>
        </section>

        <hr class="border-gray-200">

        <%# ===== P — PLAN ===== %>
        <section>
          <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
            <span class="w-8 h-8 bg-purple-100 text-purple-700 rounded-lg flex items-center justify-center text-sm font-bold">P</span>
            Plan
          </h2>

          <%= mr.fields_for :plan do |plan| %>
            <%# Prescriptions %>
            <div class="bg-gray-50 rounded-lg p-4 mb-4">
              <h3 class="text-sm font-semibold text-gray-700 mb-3">Obat / Resep</h3>

              <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".nested-field-wrapper">
                <template data-nested-form-target="template">
                  <%= plan.fields_for :prescriptions, Prescription.new, child_index: "NEW_RECORD" do |pres| %>
                    <div class="nested-field-wrapper grid grid-cols-5 gap-2 mb-2 items-end">
                      <div>
                        <%= pres.label :drug_name, "Obat", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pres.text_field :drug_name, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Nama obat" %>
                      </div>
                      <div>
                        <%= pres.label :dosage, "Dosis", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pres.text_field :dosage, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "500 mg" %>
                      </div>
                      <div>
                        <%= pres.label :frequency, "Frekuensi", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pres.text_field :frequency, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "3x/hari" %>
                      </div>
                      <div>
                        <%= pres.label :duration, "Durasi", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pres.text_field :duration, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "5 hari" %>
                      </div>
                      <div class="flex items-end gap-1">
                        <div class="flex-1">
                          <%= pres.label :notes, "Catatan", class: "block text-xs font-medium text-gray-600 mb-1" %>
                          <%= pres.text_field :notes, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Catatan" %>
                        </div>
                        <button type="button" data-action="nested-form#remove" class="p-1.5 text-red-400 hover:text-red-600 hover:bg-red-50 rounded transition">
                          <%= lucide_icon "x", class: "w-4 h-4" %>
                        </button>
                      </div>
                    </div>
                  <% end %>
                </template>

                <div data-nested-form-target="target">
                  <%= plan.fields_for :prescriptions do |pres| %>
                    <div class="nested-field-wrapper grid grid-cols-5 gap-2 mb-2 items-end">
                      <div>
                        <%= pres.label :drug_name, "Obat", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pres.text_field :drug_name, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
                      </div>
                      <div>
                        <%= pres.label :dosage, "Dosis", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pres.text_field :dosage, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
                      </div>
                      <div>
                        <%= pres.label :frequency, "Frekuensi", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pres.text_field :frequency, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
                      </div>
                      <div>
                        <%= pres.label :duration, "Durasi", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pres.text_field :duration, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
                      </div>
                      <div class="flex items-end gap-1">
                        <div class="flex-1">
                          <%= pres.label :notes, "Catatan", class: "block text-xs font-medium text-gray-600 mb-1" %>
                          <%= pres.text_field :notes, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
                        </div>
                        <%= pres.hidden_field :_destroy %>
                        <button type="button" data-action="nested-form#remove" class="p-1.5 text-red-400 hover:text-red-600 hover:bg-red-50 rounded transition">
                          <%= lucide_icon "x", class: "w-4 h-4" %>
                        </button>
                      </div>
                    </div>
                  <% end %>
                </div>

                <button type="button" data-action="nested-form#add" class="mt-2 inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-teal-600 hover:text-teal-700 hover:bg-teal-50 rounded-lg transition">
                  <%= lucide_icon "plus", class: "w-3 h-3" %> Tambah Obat
                </button>
              </div>
            </div>

            <div class="mb-4">
              <% if @visit.medical_record&.plan&.prescriptions&.any? %>
                <%= link_to print_prescription_visit_path(@visit), class: "inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium bg-amber-100 text-amber-700 rounded-lg hover:bg-amber-200 transition" do %>
                  <%= lucide_icon "printer", class: "w-3 h-3" %> Cetak Resep
                <% end %>
              <% end %>
            </div>

            <%# Plan Treatments %>
            <div class="bg-gray-50 rounded-lg p-4 mb-4">
              <h3 class="text-sm font-semibold text-gray-700 mb-3">Tindakan</h3>

              <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".nested-field-wrapper">
                <template data-nested-form-target="template">
                  <%= plan.fields_for :plan_treatments, PlanTreatment.new, child_index: "NEW_RECORD" do |pt| %>
                    <div class="nested-field-wrapper grid grid-cols-5 gap-2 mb-2 items-end">
                      <div>
                        <%= pt.label :treatment_catalog_id, "Tindakan", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pt.collection_select :treatment_catalog_id, current_user.treatment_catalogs.active.order(:name), :id, :name, { prompt: "Pilih" }, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
                      </div>
                      <div>
                        <%= pt.label :tooth_number, "Gigi No.", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pt.text_field :tooth_number, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "11" %>
                      </div>
                      <div>
                        <%= pt.label :quantity, "Jumlah", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pt.number_field :quantity, value: 1, min: 1, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
                      </div>
                      <div>
                        <%= pt.label :price, "Harga", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pt.number_field :price, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Rp" %>
                      </div>
                      <div class="flex items-end gap-1">
                        <div class="flex-1">
                          <%= pt.label :notes, "Catatan", class: "block text-xs font-medium text-gray-600 mb-1" %>
                          <%= pt.text_field :notes, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
                        </div>
                        <%= pt.hidden_field :_destroy %>
                        <button type="button" data-action="nested-form#remove" class="p-1.5 text-red-400 hover:text-red-600 hover:bg-red-50 rounded transition">
                          <%= lucide_icon "x", class: "w-4 h-4" %>
                        </button>
                      </div>
                    </div>
                  <% end %>
                </template>

                <div data-nested-form-target="target">
                  <%= plan.fields_for :plan_treatments do |pt| %>
                    <div class="nested-field-wrapper grid grid-cols-5 gap-2 mb-2 items-end">
                      <div>
                        <%= pt.label :treatment_catalog_id, "Tindakan", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pt.collection_select :treatment_catalog_id, current_user.treatment_catalogs.active.order(:name), :id, :name, { prompt: "Pilih" }, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
                      </div>
                      <div>
                        <%= pt.label :tooth_number, "Gigi No.", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pt.text_field :tooth_number, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
                      </div>
                      <div>
                        <%= pt.label :quantity, "Jumlah", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pt.number_field :quantity, min: 1, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
                      </div>
                      <div>
                        <%= pt.label :price, "Harga", class: "block text-xs font-medium text-gray-600 mb-1" %>
                        <%= pt.number_field :price, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
                      </div>
                      <div class="flex items-end gap-1">
                        <div class="flex-1">
                          <%= pt.label :notes, "Catatan", class: "block text-xs font-medium text-gray-600 mb-1" %>
                          <%= pt.text_field :notes, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
                        </div>
                        <%= pt.hidden_field :_destroy %>
                        <button type="button" data-action="nested-form#remove" class="p-1.5 text-red-400 hover:text-red-600 hover:bg-red-50 rounded transition">
                          <%= lucide_icon "x", class: "w-4 h-4" %>
                        </button>
                      </div>
                    </div>
                  <% end %>
                </div>

                <button type="button" data-action="nested-form#add" class="mt-2 inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-teal-600 hover:text-teal-700 hover:bg-teal-50 rounded-lg transition">
                  <%= lucide_icon "plus", class: "w-3 h-3" %> Tambah Tindakan
                </button>
              </div>
            </div>

            <%# Follow Up %>
            <div>
              <%= plan.label :follow_up_plan, "Rencana Tindak Lanjut", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= plan.text_area :follow_up_plan, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Rencana tindak lanjut" %>
            </div>

            <div class="mt-4">
              <%= plan.label :next_visit_date, "Kunjungan Berikutnya", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= plan.date_field :next_visit_date, class: "w-full max-w-xs px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
            </div>
          <% end %>
        </section>

      <% end %>

      <div class="flex items-center gap-3 pt-3 border-t border-gray-100">
        <%= f.submit "Simpan", class: "px-6 py-2.5 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition text-sm font-medium" %>
        <%= link_to "Batal", visits_path, class: "px-4 py-2 text-gray-600 hover:text-gray-800 transition text-sm" %>
      </div>
    <% end %>
  </div>
</div>
