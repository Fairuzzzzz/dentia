<div data-controller="odontogram" class="flex gap-6 items-start">
  <%= f.hidden_field :teeth_data, value: f.object.teeth_data.to_json, data: { odontogram_target: "dataInput" } %>
  <div class="shrink-0">
    <div class="flex items-center gap-4 mb-4">
      <span class="text-xs font-medium text-gray-600">Tipe Gigi:</span>
      <label class="inline-flex items-center gap-1.5 cursor-pointer">
        <input type="radio" name="tooth_type" value="dewasa" checked data-action="change->odontogram#toggleType" class="text-teal-600 focus:ring-teal-500">
        <span class="text-sm text-gray-700">Dewasa</span>
      </label>
      <label class="inline-flex items-center gap-1.5 cursor-pointer">
        <input type="radio" name="tooth_type" value="anak" data-action="change->odontogram#toggleType" class="text-teal-600 focus:ring-teal-500">
        <span class="text-sm text-gray-700">Anak</span>
      </label>
    </div>

    <div data-odontogram-target="svg">

    <%# ===== DEWASA ===== %>
    <div class="dewasa-set" data-tooth-type="dewasa">
      <%# Label kanan/kiri %>
      <div class="flex justify-center text-[10px] text-gray-400 mb-0.5">
        <span class="flex-1 text-left pl-1">← Kanan Pasien</span>
        <span class="w-4"></span>
        <span class="flex-1 text-right pr-1">Kiri Pasien →</span>
      </div>

      <%# RAHANG ATAS — Sec 1 (18→11) | Sec 2 (21→28) %>
      <p class="text-xs font-medium text-gray-500 text-center mb-1">RAHANG ATAS</p>
      <div class="flex items-center justify-center mb-4">
        <div class="flex gap-1">
          <% [18, 17, 16, 15, 14, 13, 12, 11].each do |id| %>
            <div data-odontogram-target="tooth" data-tooth-id="<%= id %>" data-tooth-type="dewasa"
                 data-action="click->odontogram#selectTooth"
                 class="<%= 'w-12' if id % 10 == 1 %><%= 'w-9' if id % 10 == 2 %><%= 'w-10' if id % 10 > 2 %> h-14 border-2 border-gray-300 rounded cursor-pointer hover:border-teal-400 transition flex flex-col items-center justify-center text-xs font-mono bg-white">
              <svg width="32" height="28" viewBox="0 0 40 36">
                <rect x="2" y="2" width="36" height="32" rx="4" fill="#ffffff" stroke="#d1d5db" stroke-width="1"/>
                <line x1="20" y1="4" x2="15" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="4" x2="25" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="15" y2="20" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="25" y2="20" stroke="#e5e7eb" stroke-width="1"/>
              </svg>
              <%= id %>
            </div>
          <% end %>
        </div>
        <div class="w-0.5 h-16 bg-gray-400 mx-1.5"></div>
        <div class="flex gap-1">
          <% [21, 22, 23, 24, 25, 26, 27, 28].each do |id| %>
            <div data-odontogram-target="tooth" data-tooth-id="<%= id %>" data-tooth-type="dewasa"
                 data-action="click->odontogram#selectTooth"
                 class="<%= 'w-12' if id % 10 == 1 %><%= 'w-9' if id % 10 == 2 %><%= 'w-10' if id % 10 > 2 %> h-14 border-2 border-gray-300 rounded cursor-pointer hover:border-teal-400 transition flex flex-col items-center justify-center text-xs font-mono bg-white">
              <svg width="32" height="28" viewBox="0 0 40 36">
                <rect x="2" y="2" width="36" height="32" rx="4" fill="#ffffff" stroke="#d1d5db" stroke-width="1"/>
                <line x1="20" y1="4" x2="15" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="4" x2="25" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="15" y2="20" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="25" y2="20" stroke="#e5e7eb" stroke-width="1"/>
              </svg>
              <%= id %>
            </div>
          <% end %>
        </div>
      </div>

      <%# RAHANG BAWAH — Sec 4 (48→41) | Sec 3 (31→38) %>
      <p class="text-xs font-medium text-gray-500 text-center mb-1">RAHANG BAWAH</p>
      <div class="flex items-center justify-center">
        <div class="flex gap-1">
          <% [48, 47, 46, 45, 44, 43, 42, 41].each do |id| %>
            <div data-odontogram-target="tooth" data-tooth-id="<%= id %>" data-tooth-type="dewasa"
                 data-action="click->odontogram#selectTooth"
                 class="<%= 'w-12' if id % 10 == 1 %><%= 'w-9' if id % 10 == 2 %><%= 'w-10' if id % 10 > 2 %> h-14 border-2 border-gray-300 rounded cursor-pointer hover:border-teal-400 transition flex flex-col items-center justify-center text-xs font-mono bg-white">
              <svg width="32" height="28" viewBox="0 0 40 36">
                <rect x="2" y="2" width="36" height="32" rx="4" fill="#ffffff" stroke="#d1d5db" stroke-width="1"/>
                <line x1="20" y1="4" x2="15" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="4" x2="25" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="15" y2="20" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="25" y2="20" stroke="#e5e7eb" stroke-width="1"/>
              </svg>
              <%= id %>
            </div>
          <% end %>
        </div>
        <div class="w-0.5 h-16 bg-gray-400 mx-1.5"></div>
        <div class="flex gap-1">
          <% [31, 32, 33, 34, 35, 36, 37, 38].each do |id| %>
            <div data-odontogram-target="tooth" data-tooth-id="<%= id %>" data-tooth-type="dewasa"
                 data-action="click->odontogram#selectTooth"
                 class="<%= 'w-12' if id % 10 == 1 %><%= 'w-9' if id % 10 == 2 %><%= 'w-10' if id % 10 > 2 %> h-14 border-2 border-gray-300 rounded cursor-pointer hover:border-teal-400 transition flex flex-col items-center justify-center text-xs font-mono bg-white">
              <svg width="32" height="28" viewBox="0 0 40 36">
                <rect x="2" y="2" width="36" height="32" rx="4" fill="#ffffff" stroke="#d1d5db" stroke-width="1"/>
                <line x1="20" y1="4" x2="15" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="4" x2="25" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="15" y2="20" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="25" y2="20" stroke="#e5e7eb" stroke-width="1"/>
              </svg>
              <%= id %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# ===== ANAK — same UI as adult ===== %>
    <div class="anak-set hidden" data-tooth-type="anak">
      <div class="flex justify-center text-[10px] text-gray-400 mb-0.5">
        <span class="flex-1 text-left pl-1">← Kanan Pasien</span>
        <span class="w-4"></span>
        <span class="flex-1 text-right pr-1">Kiri Pasien →</span>
      </div>

      <%# RAHANG ATAS — Sec 5 (55→51) | Sec 6 (65→61) %>
      <p class="text-xs font-medium text-gray-500 text-center mb-1">RAHANG ATAS</p>
      <div class="flex items-center justify-center mb-4">
        <div class="flex gap-1">
          <% [55, 54, 53, 52, 51].each do |id| %>
            <div data-odontogram-target="tooth" data-tooth-id="<%= id %>" data-tooth-type="anak"
                 data-action="click->odontogram#selectTooth"
                 class="<%= 'w-12' if id % 10 == 1 %><%= 'w-9' if id % 10 == 2 %><%= 'w-10' if id % 10 > 2 %> h-14 border-2 border-gray-300 rounded cursor-pointer hover:border-teal-400 transition flex flex-col items-center justify-center text-xs font-mono bg-white">
              <svg width="32" height="28" viewBox="0 0 40 36">
                <rect x="2" y="2" width="36" height="32" rx="4" fill="#ffffff" stroke="#d1d5db" stroke-width="1"/>
                <line x1="20" y1="4" x2="15" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="4" x2="25" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="15" y2="20" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="25" y2="20" stroke="#e5e7eb" stroke-width="1"/>
              </svg>
              <%= id %>
            </div>
          <% end %>
        </div>
        <div class="w-0.5 h-16 bg-gray-400 mx-1.5"></div>
        <div class="flex gap-1">
          <% [65, 64, 63, 62, 61].each do |id| %>
            <div data-odontogram-target="tooth" data-tooth-id="<%= id %>" data-tooth-type="anak"
                 data-action="click->odontogram#selectTooth"
                 class="<%= 'w-12' if id % 10 == 1 %><%= 'w-9' if id % 10 == 2 %><%= 'w-10' if id % 10 > 2 %> h-14 border-2 border-gray-300 rounded cursor-pointer hover:border-teal-400 transition flex flex-col items-center justify-center text-xs font-mono bg-white">
              <svg width="32" height="28" viewBox="0 0 40 36">
                <rect x="2" y="2" width="36" height="32" rx="4" fill="#ffffff" stroke="#d1d5db" stroke-width="1"/>
                <line x1="20" y1="4" x2="15" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="4" x2="25" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="15" y2="20" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="25" y2="20" stroke="#e5e7eb" stroke-width="1"/>
              </svg>
              <%= id %>
            </div>
          <% end %>
        </div>
      </div>

      <%# RAHANG BAWAH — Sec 8 (85→81) | Sec 7 (75→71) %>
      <p class="text-xs font-medium text-gray-500 text-center mb-1">RAHANG BAWAH</p>
      <div class="flex items-center justify-center">
        <div class="flex gap-1">
          <% [85, 84, 83, 82, 81].each do |id| %>
            <div data-odontogram-target="tooth" data-tooth-id="<%= id %>" data-tooth-type="anak"
                 data-action="click->odontogram#selectTooth"
                 class="<%= 'w-12' if id % 10 == 1 %><%= 'w-9' if id % 10 == 2 %><%= 'w-10' if id % 10 > 2 %> h-14 border-2 border-gray-300 rounded cursor-pointer hover:border-teal-400 transition flex flex-col items-center justify-center text-xs font-mono bg-white">
              <svg width="32" height="28" viewBox="0 0 40 36">
                <rect x="2" y="2" width="37" height="32" rx="4" fill="#ffffff" stroke="#d1d5db" stroke-width="1"/>
                <line x1="20" y1="4" x2="15" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="4" x2="25" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="15" y2="20" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="25" y2="20" stroke="#e5e7eb" stroke-width="1"/>
              </svg>
              <%= id %>
            </div>
          <% end %>
        </div>
        <div class="w-0.5 h-16 bg-gray-400 mx-1.5"></div>
        <div class="flex gap-1">
          <% [75, 74, 73, 72, 71].each do |id| %>
            <div data-odontogram-target="tooth" data-tooth-id="<%= id %>" data-tooth-type="anak"
                 data-action="click->odontogram#selectTooth"
                 class="<%= 'w-12' if id % 10 == 1 %><%= 'w-9' if id % 10 == 2 %><%= 'w-10' if id % 10 > 2 %> h-14 border-2 border-gray-300 rounded cursor-pointer hover:border-teal-400 transition flex flex-col items-center justify-center text-xs font-mono bg-white">
              <svg width="32" height="28" viewBox="0 0 40 36">
                <rect x="2" y="2" width="36" height="32" rx="4" fill="#ffffff" stroke="#d1d5db" stroke-width="1"/>
                <line x1="20" y1="4" x2="15" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="4" x2="25" y2="16" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="15" y2="20" stroke="#e5e7eb" stroke-width="1"/>
                <line x1="20" y1="34" x2="25" y2="20" stroke="#e5e7eb" stroke-width="1"/>
              </svg>
              <%= id %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  </div>

  <%# ===== PANEL (tidak berubah) ===== %>
  <div data-odontogram-target="panel" class="hidden w-72 shrink-0">
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <h4 class="text-sm font-semibold text-gray-700 mb-3" data-odontogram-target="toothId">Pilih Gigi</h4>
      <div class="mb-3">
        <label class="block text-xs font-medium text-gray-600 mb-1">Status</label>
        <select data-odontogram-target="statusSelect" data-action="change->odontogram#updateStatus" class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm">
          <option value="normal">Normal</option>
          <option value="caries">Karies</option>
          <option value="filled">Tambalan</option>
          <option value="missing">Tidak Ada / Cabut</option>
          <option value="crown">Mahkota</option>
          <option value="bridge">Jembatan</option>
          <option value="implant">Implan</option>
          <option value="root_canal">PSA</option>
          <option value="fracture">Fraktur</option>
          <option value="extraction_needed">Indikasi Cabut</option>
        </select>
      </div>
      <div class="mb-3">
        <label class="block text-xs font-medium text-gray-600 mb-1">Permukaan</label>
        <div class="grid grid-cols-2 gap-1">
          <% %w[mesial distal buccal lingual occlusal].each do |surface| %>
            <button type="button" data-surface="<%= surface %>" data-action="click->odontogram#toggleSurface"
                    class="px-2 py-1 text-xs rounded border bg-white border-gray-300 hover:bg-gray-50 transition">
              <%= surface.humanize %>
            </button>
          <% end %>
        </div>
      </div>
      <div class="mb-4">
        <label class="block text-xs font-medium text-gray-600 mb-1">Catatan</label>
        <%= f.text_area :notes, rows: 2, data: { odontogram_target: "notesInput", action: "input->odontogram#updateNotes" }, class: "w-full px-2 py-1.5 border border-gray-300 rounded text-sm" %>
      </div>
      <div class="flex items-center gap-2 pt-3 border-t border-gray-100">
        <button type="button" data-action="click->odontogram#acceptChanges"
                class="flex-1 px-3 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition text-sm font-medium">
          Simpan
        </button>
        <button type="button" data-action="click->odontogram#cancelChanges"
                class="px-3 py-2 text-gray-600 hover:text-gray-800 transition text-sm">
          Batal
        </button>
      </div>
    </div>
  </div>
</div>
