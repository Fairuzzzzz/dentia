<%= form_with model: @treatment_catalog, class: "space-y-4" do |f| %>
  <% if @treatment_catalog.errors.any? %>
    <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
      <ul class="list-disc pl-4 space-y-1">
        <% @treatment_catalog.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :code, t("activerecord.attributes.treatment_catalog.code"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :code, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: t("treatment.form.code_placeholder") %>
    </div>

    <div>
      <%= f.label :category, t("activerecord.attributes.treatment_catalog.category"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :category, options_for_select([t("treatment.categories.umum"), t("treatment.categories.bedah"), t("treatment.categories.konservasi"), t("treatment.categories.endodonti"), t("treatment.categories.periodonti"), t("treatment.categories.radiologi")].map { |c| [c, c] }, @treatment_catalog.category), { prompt: t("treatment.form.select_category") }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
    </div>
  </div>

  <div>
    <%= f.label :name, t("treatment.form.name_label"), class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: t("treatment.form.name_placeholder") %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.check_box :is_active, checked: @treatment_catalog.is_active != false, class: "w-4 h-4 text-teal-600 border-gray-300 rounded focus:ring-teal-500" %>
    <%= f.label :is_active, t("treatment.form.active"), class: "text-sm text-gray-700" %>
  </div>

  <div class="flex items-center gap-3 pt-3 border-t border-gray-100">
    <%= f.submit t("common.save"), class: "px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition text-sm font-medium" %>
    <%= link_to t("common.cancel"), treatment_catalogs_path, class: "px-4 py-2 text-gray-600 hover:text-gray-800 transition text-sm" %>
  </div>
<% end %>
