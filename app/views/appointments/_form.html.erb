<%= form_with model: @appointment, class: "space-y-4" do |f| %>
  <% if @appointment.errors.any? %>
    <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
      <ul class="list-disc pl-4 space-y-1">
        <% @appointment.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :patient_id, "Pasien", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :patient_id, Patient.order(:name), :id, :name, { prompt: "Pilih pasien" }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
  </div>

  <div>
    <%= f.label :appointment_date, "Tanggal & Jam", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.datetime_field :appointment_date, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" %>
  </div>

  <div>
    <%= f.label :purpose, "Keperluan", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :purpose, rows: 2, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Keperluan janji temu" %>
  </div>

  <div>
    <%= f.label :notes, "Catatan", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notes, rows: 2, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none", placeholder: "Catatan tambahan" %>
  </div>

  <div class="flex items-center gap-3 pt-3 border-t border-gray-100">
    <%= f.submit class: "px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition text-sm font-medium" %>
    <%= link_to "Batal", appointments_path, class: "px-4 py-2 text-gray-600 hover:text-gray-800 transition text-sm" %>
  </div>
<% end %>
