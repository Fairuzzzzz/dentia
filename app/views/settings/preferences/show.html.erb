<div class="max-w-4xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6"><%= t("settings.title") %></h1>

  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 mb-6">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4"><%= t("settings.appearance") %></h2>

    <div class="space-y-4">
      <div class="flex items-center justify-between" data-controller="dark-mode">
        <div>
          <p class="text-sm font-medium text-gray-900 dark:text-white"><%= t("settings.dark_mode") %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400">Gunakan tema gelap untuk kenyamanan mata</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" data-dark-mode-target="toggle" data-action="change->dark-mode#toggle" class="sr-only peer">
          <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-teal-300 dark:peer-focus:ring-teal-800 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-teal-600"></div>
        </label>
      </div>

      <hr class="border-gray-200 dark:border-gray-700">

      <div>
        <%= form_tag settings_preferences_path, method: :patch, class: "flex items-center justify-between" do %>
          <div>
            <p class="text-sm font-medium text-gray-900 dark:text-white"><%= t("settings.language") %></p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Pilih bahasa yang digunakan</p>
          </div>
          <div class="flex items-center gap-2">
            <%= radio_button_tag :locale, :id, I18n.locale == :id, class: "text-teal-600 focus:ring-teal-500" %>
            <%= label_tag :locale_id, "Indonesia", class: "text-sm text-gray-700 dark:text-gray-300 mr-3" %>
            <%= radio_button_tag :locale, :en, I18n.locale == :en, class: "text-teal-600 focus:ring-teal-500" %>
            <%= label_tag :locale_en, "English", class: "text-sm text-gray-700 dark:text-gray-300" %>
            <%= submit_tag t("common.save"), class: "ml-4 px-3 py-1.5 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition text-sm font-medium cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
